# Slim production image for the ACDE operator API + control loop (v2, P4).
# Ships the lean core only (no research/benchmark/data-plane extras). Multi-stage: build a venv with
# uv, then copy it into a small runtime image.
FROM python:3.11-slim AS build

RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
# Install ONLY the core project (no dev group, no [research] extra) into a self-contained venv.
RUN uv sync --no-dev --frozen --no-editable

FROM python:3.11-slim AS runtime

# The base image's OS packages (openssl, etc.) lag behind fixed CVEs the same way the Python-level
# ones did (D-075's tension is a Python-packaging issue; this is the OS layer) -- apt upgrade rather
# than pinning a single package by name, since the next CVE will be in a different package next time.
# postgresql-client (D-099): pg_dump/pg_restore, so `acde backup`/`acde restore` actually work
# inside the real deployed container, not just in local dev where they happen to already exist.
# The Debian mirror's by-hash index occasionally hash-mismatches against a stale CDN edge (a
# known transient mirror-propagation issue, reproduced locally while verifying this exact RUN
# line -- 4 different retries hit 4 different, differently-stale edges). `Acquire::Retries` alone
# doesn't help here since it's not a dropped connection, it's genuinely different content each
# time -- looping `apt-get update` until an edge that's actually caught up answers does.
RUN for i in 1 2 3 4 5; do apt-get update && break || sleep 3; done \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# The app runs entirely out of the self-contained venv copied in below (built by uv) -- system
# Python's pip/setuptools/wheel are never used at runtime. They're also a recurring source of stale
# CVEs (e.g. pip vendors its own pinned msgpack that lags behind fixed versions, and the base image's
# original get-pip.py-installed setuptools isn't fully replaced by `pip install --upgrade`). Strip
# them entirely rather than trying to keep unused packages patched.
RUN find /usr/local/lib/python3.11/site-packages -maxdepth 1 \
      \( -iname 'pip' -o -iname 'pip-*' -o -iname 'setuptools' -o -iname 'setuptools-*' \
         -o -iname 'wheel' -o -iname 'wheel-*' -o -iname 'pkg_resources' -o -iname '_distutils_hack' \) \
      -exec rm -rf {} + \
    && rm -rf /usr/local/lib/python3.11/ensurepip /root/.cache

# Non-root runtime user
RUN useradd --create-home --uid 10001 acde
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY infra/opa/policies ./infra/opa/policies
COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENV PATH="/app/.venv/bin:$PATH" \
    ACDE_MODE=shadow \
    MOCK_LLM=1
USER acde

EXPOSE 8099
ENTRYPOINT ["docker-entrypoint.sh"]
# Default: the operator API. Override the command with `acde run ...` to run the control loop.
# Either way, the entrypoint applies pending migrations first.
CMD ["acde", "serve", "--host", "0.0.0.0"]
